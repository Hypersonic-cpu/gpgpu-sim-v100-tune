################################################################################
# SM7_GH100 / gpgpusim.config
# Memory-focused Hopper-like compatibility config based on SM7_QV100
# Unlisted options inherit SM7_QV100 unchanged.
################################################################################

# ------------------------------------------------------------------------------
# Compatibility choice:
# keep SM70-style front-end for CUDA9 / GPGPU-Sim 4.0 compatibility,
# but transplant Hopper-class memory hierarchy parameters.
# ------------------------------------------------------------------------------
-gpgpu_compute_capability_major 7
-gpgpu_compute_capability_minor 0

# ------------------------------------------------------------------------------
# High-level architecture
# GH100/H100 SXM-class target: 132 SMs, 80GB HBM3, 5120-bit interface
# ------------------------------------------------------------------------------
-gpgpu_n_clusters 132
-gpgpu_n_cores_per_cluster 1
-gpgpu_n_mem 40
-gpgpu_n_sub_partition_per_mchannel 2

# Estimated clocks for H100 SXM-class GH100:
# core / icnt / l2 = 1830 MHz (estimate)
# dram = 2617 MHz  (derived from 3.35 TB/s over 5120-bit HBM3 interface)
-gpgpu_clock_domains 1830.0:1830.0:1830.0:2617.0

# Match visible SM count for occupancy API
-gpgpu_occupancy_sm_number 132

# ------------------------------------------------------------------------------
# Keep Volta-like core pipeline to avoid opening a Hopper front-end can of worms
# ------------------------------------------------------------------------------
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_shader_core_pipeline 2048:32
-gpgpu_shader_cta 32
-gpgpu_simd_model 1

-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_dp_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4

-ptx_opcode_latency_int 4,13,4,5,145,21
-ptx_opcode_initiation_int 2,2,2,2,8,4
-ptx_opcode_latency_fp 4,13,4,5,39
-ptx_opcode_initiation_fp 2,2,2,2,4
-ptx_opcode_latency_dp 8,19,8,8,330
-ptx_opcode_initiation_dp 4,4,4,4,130
-ptx_opcode_latency_sfu 100
-ptx_opcode_initiation_sfu 8
-ptx_opcode_latency_tesnor 64
-ptx_opcode_initiation_tensor 64

-gpgpu_sub_core_model 1
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 8
-gpgpu_operand_collector_num_in_ports_gen 8
-gpgpu_operand_collector_num_out_ports_gen 8

-gpgpu_num_reg_banks 16
-gpgpu_reg_file_port_throughput 2

# ------------------------------------------------------------------------------
# Shared memory / L1
# Hopper official limits:
#   unified L1+shared = 256 KB
#   shared per SM     = 228 KB
#   shared per block  = 227 KB
# Here I expose max capacity, but choose a middle default carveout.
# ------------------------------------------------------------------------------
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 60

-gpgpu_num_sched_per_core 4
-gpgpu_scheduler gto
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

-gpgpu_adaptive_cache_config 1
-gpgpu_l1_banks 4

# 128 KB default L1D:
# size = 1 * 128B * 1024 ways = 131072 B
-gpgpu_cache:dl1 S:1:128:1024,L:L:s:N:L,A:256:8,16:0,32

# max shared / default shared / per-block shared
-gpgpu_shmem_size 233472
-gpgpu_shmem_sizeDefault 131072
-gpgpu_shmem_per_block 232448

-gpgpu_gmem_skip_L1D 0
-gpgpu_n_cluster_ejection_buffer_size 32

# Anchor to Hopper-family microbench numbers
-gpgpu_l1_latency 41
-gpgpu_smem_latency 29
-gpgpu_flush_l1_cache 1

# ------------------------------------------------------------------------------
# L2
# H100 official L2 = 50 MB
# With 40 memory channels and 2 subpartitions/channel:
#   50 MB / 80 = 640 KB per subpartition
# Choose 256 sets * 128B * 20-way = 640 KB exactly
# ------------------------------------------------------------------------------
-gpgpu_cache:dl2 S:256:128:20,L:B:m:L:P,A:192:4,32:0,32
-gpgpu_cache:dl2_texture_only 0
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_perf_sim_memcpy 1
-gpgpu_memory_partition_indexing 2

# ------------------------------------------------------------------------------
# Interconnect
# Keep built-in local xbar, but the companion .icnt file above is consistent if
# you switch back to intersim.
# ------------------------------------------------------------------------------
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_flit_size 40
-icnt_arbiter_algo 1

# ------------------------------------------------------------------------------
# Memory partition latency
# IMPORTANT:
# gpgpu_l2_rop_latency and dram_latency are NOT directly equal to measured
# "L2 hit cycles" / "global cycles" in microbench papers.
# So I only nudge them, instead of forcing 263 / 479 literally.
# ------------------------------------------------------------------------------
-gpgpu_l2_rop_latency 180
-dram_latency 100

# ------------------------------------------------------------------------------
# DRAM / HBM3
# 40 x 128-bit = 5120-bit external interface
# ------------------------------------------------------------------------------
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 64
-gpgpu_dram_return_queue_size 192

-gpgpu_n_mem_per_ctrlr 1
-gpgpu_dram_buswidth 16
-gpgpu_dram_burst_length 2
-dram_data_command_freq_ratio 2
-gpgpu_mem_address_mask 1

# Placeholder linear mapping for 40 channels.
# You MUST verify whether your stock GPGPU-Sim address decoder is happy with
# non-power-of-two 40 channels. If not, patch the decoder or temporarily fall
# back to a compatibility 32-channel model.
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.CCCSSSSSS

# HBM3-like timing template:
# start from Ramulator2 HBM3 topology/timing shape, then scale to ~5.23 GT/s pin rate
-gpgpu_dram_timing_opt "nbk=16:CCD=1:RRD=6:RCD=18:RAS=45:RP=18:RC=63:CL=18:WL=6:CDLR=8:WR=21:nbkgrp=4:CCDL=6:RTPL=8"

# HBM dual command/data behavior
-dram_dual_bus_interface 1
